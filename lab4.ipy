   "source": [
    "from dotenv import load_dotenv\n",
    "import os\n",
    "from openai import OpenAI\n",
    "\n",
    "load_dotenv()\n",
    "API_KEY = os.environ[\"GROQ_API_KEY\"]\n",
    "\n",
    "client = OpenAI(\n",
    "    api_key=API_KEY,\n",
    "    base_url=\"https://api.groq.com/openai/v1\"\n",
    ")\n",
    "\n",
    "MODEL=\"llama-3.3-70b-versatile\"\n",
    "print(\"Client Ready\")\n",
    "print(API_KEY[:10])\n"
   ],
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Client Ready\n",
      "gsk_21WOqM\n"
     ]
    }
   ],
   "execution_count": 13
